# Copy this file to ".env" in the same folder, then fill in real values.
# Never commit the actual ".env" file.

APP_NAME=CareerAI
ENV=development
DEBUG=True

FRONTEND_ORIGIN=http://localhost:5173

# --- Database (used starting Phase 3) ---
DATABASE_URL=postgresql://careerai:careerai@localhost:5432/careerai

# --- Auth (used starting Phase 5) ---
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- AI provider (used in later AI phases) ---
LLM_PROVIDER=local
OPENAI_API_KEY=
LOCAL_LLM_URL=http://localhost:11434

# --- File storage ---
STORAGE_PATH=./uploads
